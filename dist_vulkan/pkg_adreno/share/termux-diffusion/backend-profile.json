{
  "target_platform": "Android Termux (aarch64)",
  "target_gpu_family": "Qualcomm Adreno",
  "target_devices": [
    "SM-S931N",
    "Galaxy S25",
    "Snapdragon 8 Elite",
    "Adreno 830"
  ],
  "vulkan_driver_path": "/system/lib64/libvulkan.so",
  "subgroup_wave_size": 64,
  "max_workgroup_invocations": 1024,
  "shared_memory_bytes": 32768,
  "fp16_reduction_mode": "SHADER_REDUCTION_MODE_SHMEM",
  "strict_upstream_vulkan": true
}